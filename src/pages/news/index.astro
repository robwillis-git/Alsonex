---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="News — Alsonex Pharmaceuticals" route="news">
  <section class="alx-container" style="padding:60px 0;max-width:760px">
    <h1 class="alx-h1">News</h1>
    {
      posts.map((post) => (
        <article style="padding:26px 0;border-bottom:1px solid var(--line)">
          <div style="display:flex;gap:12px;align-items:center;margin-bottom:10px;font-size:12px;color:var(--ink-muted)">
            <span class="alx-tag">{post.data.tag}</span>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-AU', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </time>
          </div>
          <h2 class="alx-h2" style="font-size:22px;margin-bottom:8px">
            <a href={`/news/${post.id}`} style="color:inherit;text-decoration:none">
              {post.data.title}
            </a>
          </h2>
          <p class="alx-p">{post.data.summary}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
