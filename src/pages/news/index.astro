---
/**
 * News — V2 "Meridian Cine" RE-SKIN of the existing V1 news collection.
 *
 * PageHead + the V2 NewsList rendering the existing content collection (3 real
 * posts), kept UNDATED (Rob's locked decision — no publication dates). Order by
 * the `order` field. Copy (titles/summaries/tags) is unchanged.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import NewsList from '../../components/NewsList.astro';
import NewsItem from '../../components/NewsItem.astro';
import { getCollection } from 'astro:content';

// Published undated (Rob's locked decision) — order by the `order` field.
const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="News — Alsonex Pharmaceuticals"
  description="Updates on Alsonex Pharmaceuticals' research into new treatments for neurodegenerative disease, including Motor Neuron Disease."
  route="news"
>
  <PageHead
    eyebrow="News"
    title="News"
    lead="Updates on Alsonex's research into new treatments for neurodegenerative disease."
    watermark="News"
  />

  <section class="section">
    <div class="wrap">
      <NewsList>
        {
          posts.map((post, i) => (
            <NewsItem
              tag={post.data.tag}
              title={post.data.title}
              excerpt={post.data.summary}
              href={`/news/${post.id}`}
              delay={i}
            />
          ))
        }
      </NewsList>
    </div>
  </section>
</BaseLayout>
