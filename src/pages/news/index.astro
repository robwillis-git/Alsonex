---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { getCollection } from 'astro:content';

// Published undated (Rob's locked decision) — order by the `order` field, not date.
const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="News — Alsonex Pharmaceuticals" route="news">
  <Hero watermark="News" title="News" short>
    <p class="alx-lead alx-center">
      Updates on Alsonex's research into new treatments for neurodegenerative disease.
    </p>
  </Hero>

  <div class="alx-container alx-news">
    {
      posts.map((post) => (
        <article class="alx-news__item">
          <div class="alx-news__meta">
            <span class="alx-tag">{post.data.tag}</span>
          </div>
          <h2 class="alx-h2 alx-news__title">
            <a href={`/news/${post.id}`} class="alx-news__link">
              {post.data.title}
            </a>
          </h2>
          <p class="alx-p">{post.data.summary}</p>
          <a class="alx-link" href={`/news/${post.id}`}>
            Read more &#8599;
          </a>
        </article>
      ))
    }
  </div>
</BaseLayout>
