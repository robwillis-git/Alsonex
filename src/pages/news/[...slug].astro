---
/**
 * News post — V2 "Meridian Cine" RE-SKIN of the V1 article template.
 *
 * PageHead (the post title becomes the page h1) + the rendered Markdown body in
 * a V2 prose column, with a "back to News" link. Posts are undated. Content is
 * unchanged from the collection.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — Alsonex Pharmaceuticals`}
  description={post.data.summary}
  ogType="article"
  route="news"
>
  <PageHead eyebrow={post.data.tag} title={post.data.title} watermark="News" />

  <section class="section">
    <div class="wrap wrap--narrow">
      <article class="prose reveal">
        <Content />
      </article>
      <p style="margin-top:36px">
        <a class="newsitem__more" href="/news">&larr; Back to News</a>
      </p>
    </div>
  </section>
</BaseLayout>
