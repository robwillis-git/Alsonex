---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — Alsonex News`}
  description={post.data.summary}
  route="news"
>
  <article class="alx-container alx-article">
    <div class="alx-article__meta">
      <span class="alx-tag">{post.data.tag}</span>
    </div>
    <h1 class="alx-h1">{post.data.title}</h1>
    <div class="alx-prose">
      <Content />
    </div>
    <p class="alx-article__back"><a class="alx-link" href="/news">&larr; Back to News</a></p>
  </article>
</BaseLayout>
