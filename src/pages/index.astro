---
/**
 * Home — V2 "Meridian Cine" PROOF (Phase 0).
 *
 * Scope: a production-faithful cinematic VIDEO HERO + the V2 sticky nav
 * (in BaseLayout's Header) + footer, to validate the V2 look on staging.
 * Ported from design_handoff_alsonex_v2/modern/meridian-cine.html with the
 * approved home decisions (INTEGRATION-V1.md).
 *
 * Below the hero is intentionally a light placeholder for now — the full
 * home sections (objective split, pipeline, stats, leadership, investor CTA)
 * with V1's real content land in Frankie's Phase 3. V1's leadership bios,
 * objective copy etc. remain in git history (tag v1-live) for reuse.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCine from '../components/HeroCine.astro';
---

<BaseLayout
  title="Alsonex Pharmaceuticals — Treatments for Neurodegenerative Disease"
  description="Alsonex Pharmaceuticals is a Brisbane clinical-stage biopharmaceutical company developing ALS-205, a candidate treatment for Motor Neuron Disease and other neurodegenerative conditions."
  route="home"
>
  <!-- CINEMATIC HERO (video) — now via the reusable <HeroCine> component,
       which carries the approved settings (no loop, 0.5× re-asserted, poster
       fallback, brightness ≈1.32, light centre scrim, dark #06182B base) and
       its own inline video-control script. -->
  <HeroCine
    headline="New treatments for "
    accent="neurodegenerative"
    headlineAfter=" disease"
    lead="Alsonex develops first-in-class therapies for the diseases medicine has struggled hardest to treat — advancing its lead compound, ALS-205, toward a new option for people living with Motor Neuron Disease."
    poster="/assets/hero-riverdelta-sunrise-right-poster.jpg"
    posterAlt="Aerial vista of a branching river delta at sunrise, echoing the form of neuron dendrites"
    buttons={[
      { label: 'Explore the Science', href: '/technology' },
      { label: 'Meet the Team', href: '/about' },
    ]}
  />

  <!-- Phase 0 placeholder below the hero. The full V2 home sections
       (objective split, pipeline, stats, leadership, investor CTA) with
       V1's real content come in Frankie's Phase 3. -->
  <section class="section section--tight">
    <div class="wrap wrap--narrow" style="text-align:center">
      <div class="eyebrow center" style="justify-content:center">Phase 0 proof</div>
      <h2 class="display h-md" style="margin-top:14px">
        Below-the-hero home sections arrive in Phase 3
      </h2>
      <p class="lead" style="margin-top:14px">
        This page validates the V2 cinematic hero and sticky navigation on staging. The objective
        split, development pipeline, stats strip, leadership grid and investor CTA — populated with
        Alsonex's real content — are built in the next phase.
      </p>
    </div>
  </section>
</BaseLayout>
