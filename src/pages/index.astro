---
/**
 * Home — V2 "Meridian Cine" (verbatim reproduction of the V2 reference).
 *
 * Reproduces design_handoff_alsonex_v2/modern/meridian-cine.html EXACTLY —
 * text AND images — section by section:
 *   cinematic video HeroCine → "Our principal commercial objective" Split
 *   (care-conversation image, "More on the Science" ghost button) → Pipe (V2
 *   set) → Stats → leadership People ("Meet the full board & advisors" button)
 *   → investor CtaBand.
 *
 * NOTE: the V2 reference leadership bios are short stand-ins, used here verbatim
 * for an exact V2 match (see report flag — Rob may prefer the longer real bios).
 * This is the HOME PAGE ONLY; inner pages correctly keep V1 content.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCine from '../components/HeroCine.astro';
import Split from '../components/Split.astro';
import Button from '../components/Button.astro';
import Pipe from '../components/Pipe.astro';
import Stats from '../components/Stats.astro';
import People from '../components/People.astro';
import CtaBand from '../components/CtaBand.astro';

// Leadership — V2 reference bios, verbatim (short stand-ins). Photos in /assets/.
const leaders = [
  {
    name: 'David Groth',
    role: 'Non-Executive Chairman',
    bio: 'Co-founder of Integra Advisory; 20+ years advising on IPOs, raisings and M&A, including 18 years at Wilson HTM as CEO.',
    image: '/assets/team-groth.jpg',
  },
  {
    name: 'Alan Robertson',
    role: 'CEO & Managing Director',
    bio: 'CEO of Pharmaxis for 14 years, raising $350M+; created PXS4728 (Boehringer Ingelheim) and invented Zomig at Wellcome.',
    image: '/assets/team-robertson.jpg',
  },
  {
    name: 'Trent Woodruff',
    role: 'Scientific Advisor',
    bio: "ARC Future Fellow at UQ researching the complement system across ALS, Huntington's and Parkinson's disease.",
    image: '/assets/team-woodruff.jpg',
  },
];
---

<BaseLayout
  title="Alsonex Pharmaceuticals — Treatments for Neurodegenerative Disease"
  description="Alsonex Pharmaceuticals is a Brisbane clinical-stage biopharmaceutical company developing ALS-205, a candidate treatment for Motor Neuron Disease and other neurodegenerative conditions."
  route="home"
>
  <!-- CINEMATIC VIDEO HERO — approved settings carried by <HeroCine>. -->
  <HeroCine
    headline="New treatments for "
    accent="neurodegenerative"
    headlineAfter=" disease"
    lead="Alsonex develops first-in-class therapies for the diseases medicine has struggled hardest to treat — advancing its lead compound, ALS-205, toward a new option for people living with Motor Neuron Disease."
    poster="/assets/hero-riverdelta-sunrise-right-poster.jpg"
    posterAlt="Aerial vista of a branching river delta at sunrise, echoing the form of neuron dendrites"
    buttons={[
      { label: 'Explore the Science', href: '/technology' },
      { label: 'Meet the Team', href: '/about' },
    ]}
  />

  <!-- MISSION / OBJECTIVE — verbatim V2 reference copy + care-conversation image. -->
  <section class="section section--tight">
    <Split
      eyebrow="Our principal commercial objective"
      heading="A focused path from the laboratory to the patient."
      lead="The objective is to develop a new treatment option for people with neurodegenerative disease — and to enhance shareholder value through the clinical development of ALS-205."
      image="/assets/care-conversation.jpg"
      imageAlt="A nurse in conversation with an older man at home"
      list={[
        'The lead compound has completed Phase I (Single &amp; Multiple Ascending Dose) in healthy volunteers, establishing a suitable dose.',
        'A Phase Ib trial in subjects with MND demonstrated safe target engagement in the intended population.',
        "Additional indications include Alzheimer's and Huntington's disease.",
      ]}
    >
      <Button slot="action" href="/technology" variant="ghost" arrow>More on the Science</Button>
    </Split>
  </section>

  <!-- DEVELOPMENT PIPELINE — V2 set (Pipe defaults). -->
  <section class="section--tight" style="padding-top:0">
    <div class="wrap">
      <div class="slabel reveal">
        <div class="eyebrow center">Development pipeline</div>
        <h2 class="display h-md" style="margin-top:14px">
          One molecule, a widening clinical frontier
        </h2>
      </div>
      <Pipe />
    </div>
  </section>

  <!-- STATS STRIP (4-up). -->
  <section class="section--tight">
    <div class="wrap reveal">
      <Stats
        items={[
          { n: '2014', l: 'Founded — out of UQ research' },
          { n: 'ALS-205', l: 'Lead clinical compound' },
          { n: 'Phase Ib', l: 'Completed in MND patients' },
          { n: '4', l: 'CNS indications in view' },
        ]}
      />
    </div>
  </section>

  <!-- LEADERSHIP — V2 reference (3 people, verbatim bios) + full-board button. -->
  <section class="section">
    <div class="wrap">
      <div class="slabel reveal">
        <div class="eyebrow center">Our leadership team</div>
        <h2 class="display h-lg" style="margin-top:16px">
          Experienced drug developers and proven operators
        </h2>
      </div>
      <People members={leaders} />
      <div class="reveal" style="text-align:center;margin-top:36px">
        <Button href="/about" variant="ghost" arrow>Meet the full board &amp; advisors</Button>
      </div>
    </div>
  </section>

  <!-- INVESTOR / PARTNER CTA. -->
  <section class="section--tight" style="padding-top:0">
    <div class="wrap reveal">
      <CtaBand
        eyebrow="For investors & partners"
        heading={'Partner with us to bring <span style="white-space:nowrap">ALS-205</span> to patients.'}
        lead="We advance our programmes to proof-of-concept, then share later-stage development with the right pharmaceutical partner. Let's talk."
        buttonLabel="Contact the team"
        buttonHref="/contact"
      />
    </div>
  </section>
</BaseLayout>
