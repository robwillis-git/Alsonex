---
/**
 * TEMPORARY diagram review page (Frankie, draft).
 *
 * Renders the four bespoke science SVG diagrams on the V2 "Meridian Cine"
 * page background at a realistic content width, so Rob can review them on
 * staging before they're wired into the real pages (/technology · /about).
 *
 * DRAFT — pending Rob's review. DELETE this file once the diagrams are
 * approved and placed in the live page markup. Not linked in the nav and
 * intentionally left out of the sitemap concerns (it's a scratch route).
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const diagrams = [
  {
    file: '/assets/diagrams/complement-cascade.svg',
    title: 'The Complement Cascade',
    note: 'Three initiation pathways → C3 convertase → C3 → C5 convertase → C5 → C5a (climax) + C5b → MAC.',
    bg: 'bg',
  },
  {
    file: '/assets/diagrams/c5a-neuroinflammation.svg',
    title: 'C5a Drives Neuroinflammation',
    note: 'C5a binds the C5a1 receptor on neurons & glia → activation → chronic neuroinflammation → neuronal loss.',
    bg: 'surface',
  },
  {
    file: '/assets/diagrams/als-205-mechanism.svg',
    title: 'ALS-205 Blocks the C5a1 Receptor',
    note: 'ALS-205 occupies the C5a1 receptor so C5a can no longer signal → inflammation calmed.',
    bg: 'bg',
  },
  {
    file: '/assets/diagrams/the-challenge.svg',
    title: 'The Challenge — Progressive Neuron Loss',
    note: 'Healthy → inflamed → lost. Optional, nice-to-have.',
    bg: 'surface',
  },
];
---

<BaseLayout
  title="Diagram preview (draft) — Alsonex"
  description="Internal draft preview of the bespoke science SVG diagrams."
>
  <section class="section">
    <div class="wrap wrap--narrow">
      <div class="eyebrow">Internal · Draft</div>
      <h1 class="display h-xl" style="margin:8px 0 14px">Science Diagrams — Draft Preview</h1>
      <p class="lead">
        Bespoke, on-brand SVG diagrams for The Science story, replacing the old raster figures.
        Authored SVG — scalable, selectable text, accessible. Drafts pending Rob's review; not yet
        wired into the live pages.
      </p>
    </div>
  </section>

  {
    diagrams.map((d) => (
      <section class="section section--tight" style="padding-top:0">
        <div class="wrap wrap--narrow">
          <div class="eyebrow">{d.title}</div>
          <p class="muted" style="margin:6px 0 18px;max-width:60ch">
            {d.note}
          </p>
          <div
            class="dprev-frame"
            data-bg={d.bg}
            set:html={`<img src="${d.file}" alt="${d.title}" loading="lazy" decoding="async" />`}
          />
        </div>
      </section>
    ))
  }

  <style>
    .dprev-frame {
      border: 1px solid var(--line-strong);
      border-radius: var(--r);
      padding: 28px;
      overflow: hidden;
    }
    .dprev-frame[data-bg='bg'] {
      background: var(--bg);
    }
    .dprev-frame[data-bg='surface'] {
      background: var(--surface);
    }
    .dprev-frame img {
      display: block;
      width: 100%;
      height: auto;
    }
  </style>
</BaseLayout>
