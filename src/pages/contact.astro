---
/**
 * Contact — V2 "Meridian Cine" RE-SKIN of the existing V1 contact page.
 *
 * PageHead + the V2 Contact/Form layout, wired to V1's working backend
 * (/contact-handler.php, honeypot + async thank-you state). Fields are
 * name / email / message only — the "Enquiry type" dropdown was DROPPED
 * (Rob's decision). Contact details keep the existing address + email; the
 * phone number is removed (per approved decisions). The existing V1 Google
 * Map and hours-of-operation are retained and restyled.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Contact from '../components/Contact.astro';

const details = [
  { term: 'Address', value: '210 Alice Street<br>Brisbane, QLD 4000' },
  { term: 'Email', value: '<a href="mailto:info@alsonex.com.au">info@alsonex.com.au</a>' },
  { term: 'Hours', value: '9:00am – 5:00pm<br>Monday to Friday' },
];
---

<BaseLayout
  title="Contact — Alsonex Pharmaceuticals"
  description="Contact Alsonex Pharmaceuticals in Brisbane, Queensland. Enquiries about the company's research into Motor Neuron Disease and other neurodegenerative diseases are welcome."
  route="contact"
>
  <PageHead
    eyebrow="Contact"
    title="Get in touch"
    lead="Alsonex is focused on developing new treatments for neurodegenerative disease such as Motor Neuron Disease. The company was founded in 2014 from research being undertaken at the University of Queensland and elsewhere into the cause of neuroinflammation and its role in causing neurodegenerative disease."
    watermark="Contact"
  />

  <section class="section">
    <Contact eyebrow="Get in touch" heading="We'd love to hear from you" details={details} />
  </section>

  <!-- Existing V1 Google Map of the Brisbane office (210 Alice Street),
       restyled into a V2 rounded frame. Standard Maps place-embed (no API key). -->
  <section class="section--tight" style="padding-top:0;padding-bottom:clamp(72px,9vw,120px)">
    <div class="wrap">
      <div class="map reveal">
        <iframe
          title="Map showing Alsonex at 210 Alice Street, Brisbane QLD 4000"
          src="https://www.google.com/maps?q=210+Alice+Street,+Brisbane+QLD+4000,+Australia&output=embed"
          width="600"
          height="450"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
