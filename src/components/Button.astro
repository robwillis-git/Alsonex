---
/**
 * Button — V2 "Meridian Cine" `.btn`.
 * Mirrors design_handoff_alsonex_v2/modern/modern.css (`.btn` + variants).
 *
 * Variants:
 *   - primary  → solid accent-blue fill (`.btn--primary`)
 *   - ghost    → transparent, strong-line border that turns accent on hover (`.btn--ghost`)
 *   - on-dark  → accent fill intended for navy bands (`.btn--on-dark`)
 *
 * Optional trailing `↗` arrow (`.arr`, animates on hover via the CSS).
 * Renders an <a> when `href` is given, otherwise a <button> — usable both as a
 * marketing link and as a form submit.
 */
interface Props {
  /** visual variant */
  variant?: 'primary' | 'ghost' | 'on-dark';
  /** show the trailing ↗ arrow glyph (`.arr`) */
  arrow?: boolean;
  /** if set, renders an anchor to this URL instead of a <button> */
  href?: string;
  /** button type when rendered as a <button> */
  type?: 'button' | 'submit' | 'reset';
  /** extra classes (e.g. utility spacing) */
  class?: string;
}

const { variant = 'primary', arrow = false, href, type = 'button', class: extra } = Astro.props;

const cls = ['btn', `btn--${variant}`, extra].filter(Boolean).join(' ');
---

{
  href ? (
    <a class={cls} href={href}>
      <slot />
      {arrow && (
        <span class="arr" aria-hidden="true">
          ↗
        </span>
      )}
    </a>
  ) : (
    <button class={cls} type={type}>
      <slot />
      {arrow && (
        <span class="arr" aria-hidden="true">
          ↗
        </span>
      )}
    </button>
  )
}
