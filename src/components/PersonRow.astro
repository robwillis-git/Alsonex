---
/**
 * PersonRow — leadership / advisor entry: teal H2 name + role, bio copy, and a
 * hard-cornered photo. Reversible. Bio copy goes in the default slot.
 * Mirrors the reference build: project/ui_kits/website/Components.jsx (PersonRow).
 */
interface Props {
  /** person's name (rendered teal; may carry trailing punctuation for layout) */
  name: string;
  /** role / title, shown muted beneath the name */
  title?: string;
  /** photo source */
  photo: string;
  /**
   * Image alt text. Decoupled from `name` so the visually-formatted name (which
   * may carry a trailing comma for layout) never leaks into the alt string and
   * gets read out as "comma" by screen readers. Defaults to the name with any
   * trailing comma/whitespace stripped.
   */
  alt?: string;
  /** place the photo first (text right) */
  reverse?: boolean;
  /**
   * CSS object-position for the photo's `cover` crop (defaults to centre).
   * Set e.g. `top center` for portraits whose head sits near the top so the
   * crop doesn't clip it.
   */
  objectPosition?: string;
}

const { name, title, photo, alt, reverse = false, objectPosition } = Astro.props;
// Clean alt text: explicit `alt` wins; otherwise strip trailing comma/space
// from the (possibly layout-formatted) name.
const altText = alt ?? name.replace(/[\s,]+$/, '');
---

<section class={`alx-row alx-person${reverse ? ' is-reverse' : ''}`}>
  <div class="alx-person__text">
    <h2 class="alx-h2">
      {name}{title && <span class="alx-person__role">{title}</span>}
    </h2>
    <div class="alx-prose"><slot /></div>
  </div>
  <div class="alx-person__media">
    <img
      src={photo}
      alt={altText}
      style={objectPosition ? `object-position: ${objectPosition}` : undefined}
    />
  </div>
</section>
