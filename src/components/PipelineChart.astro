---
/**
 * PipelineChart — native, animated multi-programme development pipeline.
 *
 * Replaces the static pipeline.png on the Technology page. Renders the approved
 * 5-stage pipeline as a set of horizontal progress tracks (one per programme),
 * each filled to its current stage. On-brand: flat, square corners, thin grey
 * track, brand-blue fill with a teal current-stage marker. Lato weight-400.
 *
 * Animation: tracks fill from 0 -> current stage when the chart scrolls into
 * view (IntersectionObserver toggles `is-revealed`); a restrained staggered
 * reveal is applied via per-row transition-delay. `prefers-reduced-motion`
 * users get the bars already filled (no animation).
 *
 * Accessibility: the real data lives in the DOM as a per-row visible meta block
 * plus an sr-only sentence ("<programme>: reached <stage>"). The bar/markers are
 * aria-hidden decoration; information never depends on colour or animation.
 *
 * Distinct from PipelineRow.astro (the discrete-stage kit component): this is a
 * continuous progress chart with the approved stage labels.
 */

interface Program {
  /** programme / compound name (e.g. "ALS-205") */
  program: string;
  /** indication / formulation (e.g. "Motor Neuron Disease") */
  indication: string;
  /** 1-based stage reached (1 = Preclinical … 5 = Phase II) */
  stage: number;
}

const stages = [
  'Preclinical',
  'IND-enabling toxicology',
  'Regulatory approval',
  'Phase I clinical trials',
  'Phase II clinical trials',
];

const programs: Program[] = [
  { program: 'ALS-205', indication: 'Motor Neuron Disease', stage: 4 },
  { program: 'ALS-205', indication: "Parkinson's Disease", stage: 3 },
  { program: 'ALS-205', indication: "Alzheimer's Disease", stage: 3 },
  { program: 'ALS-205', indication: 'Oral Formulation', stage: 2 },
];

const stageCount = stages.length;
// Fill so the bar ends at the *centre* of the reached stage column.
const fillPct = (stage: number) => ((stage - 0.5) / stageCount) * 100;
// Centre of a stage column, for positioning the current-stage marker.
const centrePct = (stage: number) => ((stage - 0.5) / stageCount) * 100;
---

<section class="alx-pchart" aria-label="ALS-205 drug development pipeline">
  <!-- Stage column headers -->
  <div class="alx-pchart__head" aria-hidden="true">
    <div class="alx-pchart__head-label"></div>
    <ol class="alx-pchart__stages">
      {
        stages.map((s, i) => (
          <li class="alx-pchart__stage">
            <span class="alx-pchart__stage-num">Stage {i + 1}</span>
            <span class="alx-pchart__stage-name">{s}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Programme rows -->
  <ul class="alx-pchart__rows">
    {
      programs.map((p, idx) => (
        <li class="alx-pchart__row" style={`--row-i:${idx};`}>
          <div class="alx-pchart__meta">
            <span class="alx-pchart__prog">{p.program}</span>
            <span class="alx-pchart__ind">{p.indication}</span>
          </div>

          {/* Accessible, animation-independent description */}
          <p class="alx-sr-only">
            {p.program} — {p.indication}: reached {stages[p.stage - 1]} (stage {p.stage} of{' '}
            {stageCount}).
          </p>

          <div class="alx-pchart__track" aria-hidden="true">
            {/* gridlines marking stage boundaries */}
            <div class="alx-pchart__grid">
              {stages.map(() => (
                <span class="alx-pchart__cell" />
              ))}
            </div>
            {/* animated fill */}
            <div class="alx-pchart__fill" style={`--fill:${fillPct(p.stage)}%;`} />
            {/* current-stage marker */}
            <div class="alx-pchart__marker" style={`--at:${centrePct(p.stage)}%;`}>
              <span class="alx-pchart__marker-label">{stages[p.stage - 1]}</span>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<script>
  // Reveal-on-scroll: add `is-revealed` to each chart once it enters the viewport.
  // prefers-reduced-motion users skip the observer and are revealed immediately
  // (CSS also disables transitions for them, so bars simply appear filled).
  const charts = document.querySelectorAll<HTMLElement>('.alx-pchart');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduce || !('IntersectionObserver' in window)) {
    charts.forEach((c) => c.classList.add('is-revealed'));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 },
    );
    charts.forEach((c) => io.observe(c));
  }
</script>
