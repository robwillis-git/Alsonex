---
/**
 * Shared site header — V2 "Meridian Cine" sticky/condensing nav.
 * Ported from design_handoff_alsonex_v2/modern/meridian-cine.html.
 *
 * - White text/logo over the cine hero → dark when stuck (.is-stuck,
 *   applied by /scripts/meridian.js at scrollY > 24).
 * - V2 CSS wordmark: ALSONE + extended-X leg (--alx-logo-x brand blue).
 * - Mobile (≤900px): .nav__burger toggles the .nav__links overlay
 *   (open/close + Esc handled by meridian.js).
 *
 * Routes: "The Science" → /science, "ALS-205" → /als-205 (new evidence page).
 * The old /technology route redirects to /science (see astro.config.mjs).
 *
 * Phase 0 note: this emits the production V2 nav so the home-hero proof
 * is faithful. Frankie may refine in Phase 1 (e.g. an Astro <Button> for
 * any future CTA), but the markup/classes here are the V2 contract.
 */
interface Props {
  route?: string;
}
const { route } = Astro.props;

const items = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'about', label: 'About', href: '/about' },
  { id: 'science', label: 'The Science', href: '/science' },
  { id: 'als-205', label: 'ALS-205', href: '/als-205' },
  { id: 'news', label: 'News', href: '/news' },
  { id: 'contact', label: 'Contact', href: '/contact' },
];
---

<header class="nav">
  <div class="wrap nav__in">
    <a class="nav__logo" href="/" aria-label="Alsonex Pharmaceuticals — Home"
      >ALSONE<span class="x" aria-hidden="true">X</span></a
    >
    <nav class="nav__links" id="primary-nav" aria-label="Primary">
      {
        items.map((it) => (
          <a href={it.href} class={route === it.id ? 'current' : undefined}>
            {it.label}
          </a>
        ))
      }
    </nav>
    <button class="nav__burger" type="button" aria-label="Open menu" aria-expanded="false">
      <i></i><i></i><i></i>
    </button>
  </div>
</header>
