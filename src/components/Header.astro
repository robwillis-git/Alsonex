---
/**
 * Shared site header — sticky white nav with a mobile drop-down.
 * Mirrors the reference build: project/ui_kits/website/Header.jsx.
 * On mobile (<=820px) the primary nav collapses behind a toggle button and
 * opens as a pale-blue (--bg-nav-tint) panel — not a blurred overlay.
 */
interface Props {
  route?: string;
}
const { route } = Astro.props;

const items = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'about', label: 'About', href: '/about' },
  { id: 'technology', label: 'The Technology', href: '/technology' },
  { id: 'news', label: 'News', href: '/news' },
  { id: 'contact', label: 'Contact', href: '/contact' },
];
---

<header class="alx-header">
  <div class="alx-container alx-header__inner" style="position:relative">
    <a class="alx-logo" href="/" aria-label="Alsonex Pharmaceuticals — Home">
      <img src="/assets/alsones_logo.jpg" alt="Alsonex Pharmaceuticals" />
    </a>
    <button
      class="alx-navtoggle"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="alx-primary-nav"
    >
      <span class="alx-navtoggle__bar" aria-hidden="true"></span>
    </button>
    <nav class="alx-nav" id="alx-primary-nav" aria-label="Primary">
      {
        items.map((it) => (
          <a href={it.href} class={`alx-nav__item${route === it.id ? ' is-current' : ''}`}>
            {it.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const toggle = document.querySelector('.alx-navtoggle');
    const nav = document.getElementById('alx-primary-nav');
    if (!toggle || !nav) return;
    toggle.addEventListener('click', function () {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>
