# Example environment — copy to .env for local notes only. NEVER commit .env.
# Deploy credentials live in GitHub repo SECRETS, not here. This file just
# documents what the deploy workflow and PHP handler expect.

# --- Deploy (GitHub Actions repo secrets) ---
# FTP_HOST=ftp.alsonex.com.au
# FTP_USERNAME=
# FTP_PASSWORD=
# (or SSH) SSH_HOST= / SSH_USER= / SSH_PRIVATE_KEY=

# --- Deploy targets (GitHub Actions repo variables) ---
# FTP_REMOTE_DIR_STAGING=/public_html/staging/
# FTP_REMOTE_DIR_LIVE=/public_html/

# --- Contact form (configured inside public/contact-handler.php on the host) ---
# CONTACT_TO_EMAIL=info@alsonex.com.au
# CAPTCHA_SECRET=
